{
  "name": "smilk-launcher",
  "version": "1.1.7",
  "description": "Custom Minecraft Launcher with dynamic animated themes",
  "author": "Saiko <maksum2007123@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:rpm": "electron-builder --linux rpm",
    "build:appimage": "electron-builder --linux AppImage",
    "build:flatpak": "electron-builder --linux flatpak",
    "build:all": "electron-builder -wl"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.smilk.launcher",
    "productName": "smilk",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "smilk-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "tar.gz"
      ],
      "icon": "icon.png",
      "category": "Game",
      "maintainer": "saiko",
      "vendor": "smilk",
      "executableName": "smilk",
      "artifactName": "smilk-${version}.${ext}",
      "synopsis": "Custom Minecraft Launcher with dynamic animated themes",
      "description": "Custom Minecraft Launcher with dynamic animated themes",
      "desktop": {
        "Name": "smilk",
        "Comment": "Custom Minecraft Launcher with dynamic animated themes",
        "Keywords": "game;minecraft;launcher;smilk;",
        "Categories": "Game;ActionGame;AdventureGame;"
      }
    },
    "rpm": {
      "packageName": "smilk",
      "artifactName": "smilk-${version}.${arch}.rpm",
      "category": "Amusements/Games",
      "synopsis": "Custom Minecraft Launcher"
    },
    "flatpak": {
      "branch": "stable",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08",
      "artifactName": "smilk-${version}.${arch}.flatpak",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=host",
        "--filesystem=xdg-run/discord-ipc-0",
        "--talk-name=org.freedesktop.Notifications"
      ]
    },
    "appImage": {
      "artifactName": "smilk-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Saiko6540",
        "repo": "smilk-launcher"
      }
    ]
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "adm-zip": "^0.5.14",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  }
}
